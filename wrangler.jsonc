{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lively-limit-c354",
  "main": "worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin.html"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
